# Token do bot do Telegram (obtenha em @BotFather)
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI

# IDs de usuários autorizados (opcional, separados por vírgula)
# Se vazio, qualquer um pode usar o bot
AUTHORIZED_USERS=

# Intervalo mínimo entre alertas em minutos (padrão: 30)
ALERT_INTERVAL_MINUTES=30

# Máximo de resultados por busca (padrão: 15)
MAX_RESULTS=15
